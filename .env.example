# Copy this file to .env.local and fill in the values (Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Optional. Only used for server-side admin scripts. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend). Without a verified domain, Resend only delivers to the email you signed up with.
# RESEND_API_KEY=
# EMAIL_FROM=Mazbien IntelliHub <hello@yourdomain.com>

# AI summary (Anthropic API). Without a key the "Write my summary with AI" button shows a friendly message.
# ANTHROPIC_API_KEY=
# Optional. Only set this if the default model name is rejected. Use a model name from your Anthropic Console.
# ANTHROPIC_MODEL=claude-haiku-5-5
